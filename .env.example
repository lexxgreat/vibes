# Yandex.Metrika counter ID (number only, e.g. 113476860)
NEXT_PUBLIC_YM_ID=

# Telegram bot for conversion notifications
# Get BOT_TOKEN from @BotFather, CHAT_ID from @userinfobot (personal)
# or -100... for a group (after making the bot a group admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin dashboard token (visit /admin?token=...)
ADMIN_TOKEN=

# Supabase (free Postgres) — used for storing conversion events
# Get these from your Supabase project: Settings → API
# Use the "anon publishable" key — the table has RLS policies for anon.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_KEY=
